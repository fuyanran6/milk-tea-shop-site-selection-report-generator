# 高德 Web 服务 Key（服务端 POI/地理编码/静态底图；配置后访客可不填 Web Key，但消耗你的配额）
AMAP_WEB_KEY=

# 高德 JS API Key（浏览器地图显示；须与 Web Key 同应用或分别申请）
AMAP_JS_KEY=

# JS API 安全密钥（控制台启用时填写）
AMAP_SECURITY_JS_CODE=

# 服务配置
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=10

# 可选 LLM（无则使用模板填槽）
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Vercel 部署：在 Vercel 控制台 → Settings → Environment Variables 中配置上述 Key
# 本地开发复制本文件为 .env 后填写
